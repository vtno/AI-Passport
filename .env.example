# AI Passport standalone (.env) - copy to .env (same directory) and edit, then:
#   docker compose up -d --force-recreate
#
# Only used by the standalone base (mode B). Mode A (./aipass) uses the host
# stack's own .env - this repo never swaps it.

# Admin - REQUIRED before exposing outside localhost.
# Use strong random values (e.g. `openssl rand -hex 16`).
LITELLM_MASTER_KEY=changeme-strong-random-key
UI_USERNAME=admin
UI_PASSWORD=changeme-strong-password
LITELLM_LOGLEVEL=INFO

# Database (postgres service in docker-compose.yml, internal-only; the db
# service exposes no port). Password must match POSTGRES_PASSWORD there.
DATABASE_URL=postgresql://litellm:litellm-pg@db:5432/litellm

# Redis (redis service in docker-compose.yml) - rate limits, budget counters,
# cross-pod coordination. Referenced by general_settings.coordination_redis.url.
REDIS_URL=redis://redis:6379

# --- Grok OAuth (SuperGrok) ---
# No XAI_API_KEY needed when using OAuth. Token is persisted via the
# xai_oauth_data volume -> /root/.config/litellm/xai_oauth
# Login: docker compose exec litellm litellm xai-oauth login
# Optional overrides:
# XAI_OAUTH_TOKEN_DIR=/root/.config/litellm/xai_oauth
# XAI_OAUTH_AUTH_FILE=auth.json
# XAI_API_KEY=xai-...  # only if you prefer API-key over OAuth
