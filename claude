#!/usr/bin/env bash
# Start Claude Code against the AI Passport gateway with a given model.
# Usage:
#   ./claude                        # default model: grok-4.6-ant
#   ./claude <model_name> [claude args...]
#   ./claude -h                     # this help
#
# Credentials: LITELLM_BASE_URL / LITELLM_API_KEY from env, else this repo's
# .env (LITELLM_MASTER_KEY), else interactive prompt (optionally saved to
# your shell profile). No env vars required up front.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
die() { printf "\033[31mError: %s\033[0m\n" "$1" >&2; exit 1; }
ok()  { printf "\033[32m    %s\033[0m\n" "$1" >&2; }

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  grep '^# ' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi
MODEL="${1:-grok-4.6-ant}"
[ $# -gt 0 ] && shift

BASE="${LITELLM_BASE_URL:-}"
KEY="${LITELLM_API_KEY:-}"
if [ -z "$KEY" ] && [ -f "$HERE/.env" ]; then
  KEY="$(grep -E '^LITELLM_MASTER_KEY=' "$HERE/.env" | head -1 | cut -d= -f2-)"
fi

# Interactive prompt for whatever is missing (fresh box / partial env).
if { [ -z "$KEY" ] || [ -z "$BASE" ]; } && [ -t 0 ]; then
  if [ -z "$BASE" ]; then
    printf "  Gateway URL [http://localhost:4000]: " >&2
    read -r BASE || true
  fi
  BASE="${BASE:-http://localhost:4000}"
  if [ -z "$KEY" ]; then
    printf "  LITELLM_API_KEY: " >&2
    read -r KEY || true
  fi
  [ -n "$KEY" ] || die "no API key given (set LITELLM_API_KEY or add LITELLM_MASTER_KEY to .env)"
  printf "  Save to shell profile so future shells pick it up? [y/N] " >&2
  read -r yn || true
  if [[ "${yn:-n}" =~ ^[Yy]$ ]]; then
    printf "  RC file to append to [~/.bashrc]: " >&2
    read -r PROFILE || true
    PROFILE="${PROFILE:-$HOME/.bashrc}"
    PROFILE="${PROFILE/#\~/$HOME}"
    printf '\n# AI Passport gateway (added by ./claude)\nexport LITELLM_BASE_URL="%s"\nexport LITELLM_API_KEY="%s"\n' \
      "$BASE" "$KEY" >> "$PROFILE"
    ok "Saved to $PROFILE (new shells pick it up automatically)."
  fi
fi
[ -n "$KEY" ]  || die "no API key: set LITELLM_API_KEY or create .env"
[ -n "$BASE" ] || BASE="http://localhost:4000"

export LITELLM_BASE_URL="$BASE" LITELLM_API_KEY="$KEY"

# Resolve the real claude CLI, skipping this script (the repo dir may be on
# PATH, in which case `claude` would find itself and recurse).
SELF="$(realpath "$0")"
CLAUDE_BIN=""
while IFS= read -r p; do
  [ "$(realpath "$p" 2>/dev/null)" != "$SELF" ] && { CLAUDE_BIN="$p"; break; }
done < <(type -aP claude 2>/dev/null || true)
[ -n "$CLAUDE_BIN" ] || die "claude CLI not found on PATH (install: npm i -g @anthropic-ai/claude-code)"

source "$HERE/assets/claude-code-env.sh" "$MODEL"
exec "$CLAUDE_BIN" "$@"
